# GENTRA Audio AI Backend Configuration Template
# Salin file ini menjadi .env dan isi API key yang Anda miliki

# 1. Google Gemini Neural TTS (Voice Natural)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 2. ElevenLabs Multilingual v2 / Flash v2.5 (Studio Hyper-Realistic)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# 3. Microsoft Azure Cognitive Speech (GadisNeural & ArdiNeural)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=southeastasia

# 4. Google Cloud Text-to-Speech (Neural2 Enterprise)
GOOGLE_CLOUD_TTS_KEY=your_google_cloud_tts_key_here

# 5. Voicebox Local AI Workstation (100% Offline Sovereign Privacy)
VOICEBOX_PORT=17493
